# =============================================================================
# Kwami LiveKit Agent - Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your credentials:
#   cp .env.sample .env
#
# =============================================================================

# =============================================================================
# LiveKit Configuration
# =============================================================================
# Get these from https://cloud.livekit.io/projects/YOUR_PROJECT/settings/keys

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# =============================================================================
# AI Provider API Keys
# =============================================================================

# OpenAI - For LLM (GPT-4) and optionally TTS
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Deepgram - For Speech-to-Text (STT)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-key

# Cartesia - For Text-to-Speech (TTS)
# Get from: https://play.cartesia.ai/
CARTESIA_API_KEY=your-cartesia-key

# ElevenLabs - Alternative TTS
# Get from: https://elevenlabs.io/
# ELEVENLABS_API_KEY is accepted as an alias for this variable.
ELEVEN_API_KEY=your-elevenlabs-key

# Google - For Gemini models and Google TTS
# Get from: https://aistudio.google.com/apikey
# Either this or GOOGLE_APPLICATION_CREDENTIALS (path to a service-account JSON
# file) counts as configured; the plugin itself may require the latter.
GOOGLE_API_KEY=your-google-key
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# AssemblyAI - Alternative STT
# Get from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your-assemblyai-key

# Anthropic - Alternative LLM (Claude)
# Get from: https://platform.claude.com/
ANTHROPIC_API_KEY=your-anthropic-key

# Groq - Fast inference (Llama, Mixtral)
# Get from: https://console.groq.com/
GROQ_API_KEY=your-groq-key

# DeepSeek - DeepSeek Chat & Reasoner
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-key

# Mistral - Mistral Large and friends
# Get from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your-mistral-key

# Cerebras - Fast Llama inference
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-key

# xAI - Grok models
# Get from: https://console.x.ai/
XAI_API_KEY=your-xai-key

# =============================================================================
# Web Search
# =============================================================================
# Get your API key at https://tavily.com/
# The agent runs search on the server and sends results to the client for display.

TAVILY_API_KEY=tvly-your-tavily-api-key

# SerpApi key for real product search (Google Shopping).
# When set, the agent uses product_search so users see actual product cards (image, name, price) instead of store links.
# Get key at https://serpapi.com/

SERPAPI_KEY=your-serpapi-key

# =============================================================================
# Long-term Memory - Zep Cloud
# =============================================================================
# Each Kwami maintains independent persistent memory of all conversations.
# 
# Get your API key:
#   1. Create account at https://app.getzep.com/
#   2. Go to Project Settings > API Keys
#   3. Create a new API key
#
# More info: https://www.getzep.com/

ZEP_API_KEY=z_your-zep-api-key

# =============================================================================
# Web Navigation - Browser Use Cloud (Optional)
# =============================================================================
# The agent can browse the web in a cloud browser (via Browser Use Cloud).
# A live view is embedded in the user's app as an iframe. Per-user profiles
# persist cookies/logins across sessions.
#
# Get your API key at: https://cloud.browser-use.com/settings?tab=api-keys
# Free tier: 3 concurrent browsers.

BROWSER_USE_API_KEY=bu_your-browser-use-api-key

# Allow the LLM to execute arbitrary JavaScript in the cloud browser.
# OFF by default and it should stay off: read_navigation_page feeds untrusted
# page text to the model, and the browser profile carries the user's cookies
# and logins, so page content could steer the model into running code as them.
# KWAMI_ALLOW_BROWSER_JS=false

# =============================================================================
# Credits System - Usage Reporting
# =============================================================================
# The agent reports AI usage to the API so credits can be deducted.
# These must match the values in the kwami-lk-api .env.

KWAMI_API_URL=http://localhost:8080
KWAMI_API_KEY=your-random-kwami-api-key

# Timeout in seconds for the runtime-config fetch on telephony sessions.
# Telephony callers hear a default placeholder agent until this call returns,
# so keep it short.
KWAMI_API_TIMEOUT=30.0
