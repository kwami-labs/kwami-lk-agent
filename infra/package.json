{
  "name": "kwami-lk-agent-infra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "types": "wrangler types",
    "check": "wrangler deploy --dry-run --env=\"\"",
    "tail": "wrangler tail",
    "secrets:bulk": "wrangler secret bulk",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
